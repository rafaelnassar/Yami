{
  "name": "yami",
  "productName": "Yami",
  "version": "2.0.2",
  "description": "App desktop para gallery-dl e yt-dlp — fila, biblioteca e notificações.",
  "author": {
    "name": "Rafael Nassar",
    "url": "https://github.com/rafaelnassar"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelnassar/Yami.git"
  },
  "homepage": "https://rafaelnassar.github.io/Yami/",
  "bugs": {
    "url": "https://github.com/rafaelnassar/Yami/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:bundles && npm run build:renderer",
    "build:bundles": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.renderer-tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "test:coverage": "c8 --include=src/shared/kernel/** --include=src/shared/domain/** --include=src/host/domain/** --exclude=**/*.test.ts --check-coverage --lines=80 --functions=80 --branches=70 --reporter=text --reporter=lcov node scripts/test.mjs shared/kernel shared/domain host/domain tests/architecture",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "runtime:pin": "node scripts/update-runtime-manifest.mjs",
    "runtime:verify": "node scripts/update-runtime-manifest.mjs --verify",
    "pack": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "smoke": "node scripts/smoke-packaged.mjs",
    "dist": "npm run runtime:verify && npm run build && electron-builder --config electron-builder.config.cjs",
    "release": "npm run runtime:verify && npm run build && electron-builder --config electron-builder.config.cjs --publish always"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "c8": "^10.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "^11.18.2",
    "globals": "^16.4.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.24",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "axios": "^1.18.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "shell-quote": "^1.10.0",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "undici": "^6.28.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
